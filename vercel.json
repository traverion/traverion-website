{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/14-vietnam-thailand",
      "destination": "/index.html"
    },
    {
      "source": "/9-vietnam",
      "destination": "/index.html"
    },
    {
      "source": "/12-vietnam",
      "destination": "/index.html"
    },
    {
      "source": "/10-thailand",
      "destination": "/index.html"
    },
    {
      "source": "/10-cambodia",
      "destination": "/index.html"
    },
    {
      "source": "/14-indochina",
      "destination": "/index.html"
    },
    {
      "source": "/packages",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/destinations",
      "destination": "/index.html"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "admin.traverion.com" }],
      "destination": "/robots-admin.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "www.traverion.com" }],
      "destination": "https://admin.traverion.com/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "traverion.com" }],
      "destination": "https://admin.traverion.com/login",
      "permanent": true
    },
    {
      "source": "/supplier-log-in",
      "has": [{ "type": "host", "value": "www.traverion.com" }],
      "destination": "https://partner.traverion.com/login",
      "permanent": true
    },
    {
      "source": "/supplier-log-in",
      "has": [{ "type": "host", "value": "traverion.com" }],
      "destination": "https://partner.traverion.com/login",
      "permanent": true
    },
    {
      "source": "/supplier",
      "has": [{ "type": "host", "value": "www.traverion.com" }],
      "destination": "https://partner.traverion.com/partner",
      "permanent": true
    },
    {
      "source": "/supplier",
      "has": [{ "type": "host", "value": "traverion.com" }],
      "destination": "https://partner.traverion.com/partner",
      "permanent": true
    },
    {
      "source": "/supplier/:path*",
      "has": [{ "type": "host", "value": "www.traverion.com" }],
      "destination": "https://partner.traverion.com/partner/:path*",
      "permanent": true
    },
    {
      "source": "/supplier/:path*",
      "has": [{ "type": "host", "value": "traverion.com" }],
      "destination": "https://partner.traverion.com/partner/:path*",
      "permanent": true
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "www.traverion.com" }],
      "destination": "https://partner.traverion.com/login",
      "permanent": true
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "traverion.com" }],
      "destination": "https://partner.traverion.com/login",
      "permanent": true
    },
    {
      "source": "/thailand-vietnam-14-day",
      "destination": "/14-vietnam-thailand",
      "permanent": true
    },
    {
      "source": "/vietnam-9-day",
      "destination": "/9-vietnam",
      "permanent": true
    },
    {
      "source": "/vietnam-12-day",
      "destination": "/12-vietnam",
      "permanent": true
    },
    {
      "source": "/thailand-10-day",
      "destination": "/10-thailand",
      "permanent": true
    },
    {
      "source": "/cambodia-10-day",
      "destination": "/10-cambodia",
      "permanent": true
    },
    {
      "source": "/indochina-14-day",
      "destination": "/14-indochina",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.traverion.com" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}