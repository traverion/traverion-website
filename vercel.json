{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/14-vietnam-thailand",
      "destination": "/index.html"
    },
    {
      "source": "/9-vietnam",
      "destination": "/index.html"
    },
    {
      "source": "/12-vietnam",
      "destination": "/index.html"
    },
    {
      "source": "/10-thailand",
      "destination": "/index.html"
    },
    {
      "source": "/10-cambodia",
      "destination": "/index.html"
    },
    {
      "source": "/14-indochina",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/thailand-vietnam-14-day",
      "destination": "/14-vietnam-thailand",
      "permanent": true
    },
    {
      "source": "/vietnam-9-day",
      "destination": "/9-vietnam",
      "permanent": true
    },
    {
      "source": "/vietnam-12-day",
      "destination": "/12-vietnam",
      "permanent": true
    },
    {
      "source": "/thailand-10-day",
      "destination": "/10-thailand",
      "permanent": true
    },
    {
      "source": "/cambodia-10-day",
      "destination": "/10-cambodia",
      "permanent": true
    },
    {
      "source": "/indochina-14-day",
      "destination": "/14-indochina",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}