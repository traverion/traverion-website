# Supabase Configuration
# Copy this file to .env.local and fill in your actual Supabase credentials

# Get these from your Supabase project settings:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the Project URL and anon/public key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SITE_URL=https://traverion.com

# Supabase Edge Function secrets (set in Supabase, not in Vite env):
# RESEND_API_KEY=re_xxx
# SUPPLIER_EMAIL_FROM="Traverion <no-reply@traverion.com>"
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Example:
# VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

