# Set to "true" to show seed tours (Vietnam, Thailand, Cambodia, etc.) in the main listing.
# When unset or "false", only supplier-created listings are shown (global platform mode).
# VITE_SHOW_SEED_LISTINGS=true

# Supabase (optional). When set, listings and supplier auth use Supabase instead of localStorage.
# Create a project at https://supabase.com, then run the SQL in supabase/migrations/001_initial.sql in the SQL Editor.
# Enable Email auth in Authentication → Providers. Create a user for testing supplier login.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (test mode for Phase 1 checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Edge function runtime secrets (set with Supabase CLI, not in Vite env):
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# PUBLIC_SITE_URL=http://localhost:5173
# CUSTOMER_BOOKING_EMAIL_FROM="Traverion <bookings@your-verified-domain.com>"  (optional; defaults in notify-customer-booking)

# Panel allowlist is public.admin (migration 037) + Auth role admin — no email env vars.

# Canonical site URL for Supabase email links (confirm signup, password reset). When unset, production
# uses https://www.traverion.com — never localhost, so verification always lands on the real site.
# Staging: set to your preview URL. Must be listed under Supabase → Authentication → Redirect URLs.
# VITE_SITE_URL=https://www.traverion.com
